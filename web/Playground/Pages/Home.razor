@page "/"
@using International.EInvoicing.Playground.Components

<PageTitle>International.EInvoicing — playground</PageTitle>

<header class="hero">
    <h1>International.EInvoicing</h1>
    <p class="lead">
        Build, read, check and convert electronic invoices for eight countries — UBL, CII, Factur-X,
        XRechnung, Peppol BIS, EHF, French lifecycle statuses and e-reporting.
    </p>
    <p class="privacy">
        Everything below runs in your browser. <strong>No invoice you open here reaches a server.</strong>
    </p>
</header>

<nav class="tabs">
    @foreach ((string key, string label) in Tabs)
    {
        <button type="button" class="@(_tab == key ? "tab active" : "tab")" @onclick="() => _tab = key">
            @label
        </button>
    }
</nav>

<main>
    @switch (_tab)
    {
        case "validate":
            <ValidatorPanel />
            break;
        case "explore":
            <ExplorerPanel />
            break;
        case "build":
            <GeneratorPanel />
            break;
        case "convert":
            <ConverterPanel />
            break;
        default:
            <CoveragePanel />
            break;
    }
</main>

@code {
    private static readonly (string Key, string Label)[] Tabs =
    [
        ("validate", "Check a document"),
        ("explore", "Look inside one"),
        ("build", "Build one for a country"),
        ("convert", "Convert between syntaxes"),
        ("coverage", "What is supported"),
    ];

    private string _tab = "build";
}
