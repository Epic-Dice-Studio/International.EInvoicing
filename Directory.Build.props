<Project>

  <!-- =====================================================================
       Solution-wide build settings.
       Every project in src/ and tests/ inherits from this file.
       See docs/adr/ for the rationale behind these choices.
       ===================================================================== -->

  <PropertyGroup Label="Language">
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Determinism">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Repository">
    <RepositoryUrl>https://github.com/Epic-Dice-Studio/International.EInvoicing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Epic-Dice-Studio/International.EInvoicing</PackageProjectUrl>
    <Authors>Epic-Dice-Studio and contributors</Authors>
    <Company>Epic-Dice-Studio</Company>
    <Copyright>Copyright (c) Epic-Dice-Studio and contributors</Copyright>
  </PropertyGroup>

</Project>
