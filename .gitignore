## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Rider / IntelliJ
.idea/

# DocFX output
docs/_site/
docs/api/

# Artefacts fetched locally but not redistributable (see specs/peppol/PROVENANCE.md)
specs/peppol/rules/
specs/peppol/examples/
specs/peppol/unit-UBL-PEPPOL/
specs/peppol/unit-CII-PEPPOL/
specs/peppol/pint/
specs/peppol/poacc/
specs/en16931/compiled/
specs/national/

# Order-X: the schemas and rule sets are FNFE-MPE's and FeRD's, carried by a third party's repository.
# Their own package is registration-walled, so nothing here may be redistributed on their behalf.
specs/order-x/schema/
specs/order-x/schematron/
specs/order-x/examples/
specs/order-x/LICENSE.upstream.txt

# French rule sets: published by the DGFiP, carried by a repository that declares no licence
specs/fr-dse/rules/
specs/fr-dse/samples/
specs/fr-dse/schemas/
