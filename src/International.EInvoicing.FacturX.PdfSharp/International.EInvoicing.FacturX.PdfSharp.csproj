<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.FacturX.PdfSharp</PackageId>
    <Description>
      The default PDF implementation for International.EInvoicing.FacturX, built on PDFsharp: embeds the CII
      payload into a PDF and extracts it back out, with the Factur-X XMP metadata.
    </Description>
    <PackageTags>e-invoicing;einvoice;factur-x;facturx;zugferd;pdf;pdfsharp;pdfa3;invoice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="PDFsharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing.FacturX/International.EInvoicing.FacturX.csproj" />
  </ItemGroup>

</Project>
