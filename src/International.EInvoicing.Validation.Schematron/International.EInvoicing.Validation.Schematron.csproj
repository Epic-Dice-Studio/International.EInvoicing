<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.Validation.Schematron</PackageId>
    <Description>
      Runs official Schematron rule sets against invoices, as data rather than as generated code, so a rule
      set stays correct when its publisher revises it. Includes the XPath subset the published artefacts
      actually use, with exact decimal arithmetic.
    </Description>
    <PackageTags>e-invoicing;einvoice;schematron;validation;en16931;xpath;invoice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The XPath engine is an implementation detail, but it is the part that most needs testing. -->
    <InternalsVisibleTo Include="International.EInvoicing.Validation.Schematron.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing.Core/International.EInvoicing.Core.csproj" />
  </ItemGroup>

</Project>
