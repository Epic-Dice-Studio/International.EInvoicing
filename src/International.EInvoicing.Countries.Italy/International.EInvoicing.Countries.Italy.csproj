<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.Countries.Italy</PackageId>
    <Description>
      What Italian electronic invoicing adds on top of the norms over Peppol: the Partita IVA with its check
      digit, and the address the Italian rules require. FatturaPA and the SDI are a separate project.
    </Description>
    <PackageTags>e-invoicing;einvoice;italy;italia;peppol;partita-iva;invoice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing/International.EInvoicing.csproj" />
    <ProjectReference Include="../International.EInvoicing.Peppol/International.EInvoicing.Peppol.csproj" />
    <ProjectReference Include="../International.EInvoicing.Peppol/International.EInvoicing.Peppol.csproj" />
  </ItemGroup>

</Project>
