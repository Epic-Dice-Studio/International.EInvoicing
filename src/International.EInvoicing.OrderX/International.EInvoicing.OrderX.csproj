<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.OrderX</PackageId>
    <Description>
      Reads and writes Order-X: the Franco-German order, order change and order response, published by
      FNFE-MPE and FeRD on the UN/CEFACT Cross Industry Order message. The same family as Factur-X, one
      document earlier in the chain.
    </Description>
    <PackageTags>e-invoicing;einvoice;order-x;orderx;order;uncefact;cii;facturx;zugferd;france;germany</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing.Cii/International.EInvoicing.Cii.csproj" />
    <ProjectReference Include="../International.EInvoicing.Core/International.EInvoicing.Core.csproj" />
  </ItemGroup>

</Project>
