<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.Countries.Greece</PackageId>
    <Description>
      What Greek electronic invoicing adds on top of the norms: the AFM with its checksum, and the
      six-segment invoice number the Greek Peppol rules require.
    </Description>
    <PackageTags>e-invoicing;einvoice;greece;mydata;peppol;afm;tin;invoice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing/International.EInvoicing.csproj" />
    <ProjectReference Include="../International.EInvoicing.Peppol/International.EInvoicing.Peppol.csproj" />
    <ProjectReference Include="../International.EInvoicing.Peppol/International.EInvoicing.Peppol.csproj" />
  </ItemGroup>

</Project>
