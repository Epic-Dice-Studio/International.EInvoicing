<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.Cii</PackageId>
    <Description>
      Reads and writes UN/CEFACT Cross Industry Invoice (D22B) documents for International.EInvoicing, mapping
      them to and from the EN 16931 canonical model while preserving the raw text of every field. CII is the
      syntax of Factur-X, ZUGFeRD and XRechnung CII.
    </Description>
    <PackageTags>e-invoicing;einvoice;en16931;cii;uncefact;factur-x;zugferd;xrechnung;invoice;xml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing.Core/International.EInvoicing.Core.csproj" />
  </ItemGroup>

</Project>
