<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>International.EInvoicing.Zugferd1</PackageId>
    <Description>
      Reads ZUGFeRD 1.0, the 2013 German hybrid invoice, into the same model as everything else — so an
      archive of them can be read, reported on, and converted forward to ZUGFeRD 2, Factur-X or UBL.
      Reading only: nothing should be written in a format its own publisher replaced.
    </Description>
    <PackageTags>e-invoicing;einvoice;zugferd;zugferd1;legacy;archive;migration;cii;uncefact;germany</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../International.EInvoicing.Cii/International.EInvoicing.Cii.csproj" />
    <ProjectReference Include="../International.EInvoicing.Core/International.EInvoicing.Core.csproj" />
    <ProjectReference Include="../International.EInvoicing.Validation.Schematron/International.EInvoicing.Validation.Schematron.csproj" />
  </ItemGroup>

</Project>
