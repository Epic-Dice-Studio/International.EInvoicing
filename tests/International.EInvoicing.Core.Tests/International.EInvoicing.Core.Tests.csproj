<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Locally the tests run on the SDK's own runtime, so only the .NET 10 SDK is needed to contribute.
         CI installs the .NET 8 runtime as well and passes -p:TestAllTargetFrameworks=true so the library is
         exercised on every framework it ships for. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TestAllTargetFrameworks)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Culture-safety is a promise of this library, so the tests run under real cultures. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/International.EInvoicing.Core/International.EInvoicing.Core.csproj" />
  </ItemGroup>

</Project>
