<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TestAllTargetFrameworks)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/International.EInvoicing/International.EInvoicing.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Peppol/International.EInvoicing.Peppol.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Validation.XRechnung/International.EInvoicing.Validation.XRechnung.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.France/International.EInvoicing.Countries.France.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Germany/International.EInvoicing.Countries.Germany.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Belgium/International.EInvoicing.Countries.Belgium.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Netherlands/International.EInvoicing.Countries.Netherlands.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Norway/International.EInvoicing.Countries.Norway.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Sweden/International.EInvoicing.Countries.Sweden.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Denmark/International.EInvoicing.Countries.Denmark.csproj" />
    <ProjectReference Include="../../src/International.EInvoicing.Countries.Iceland/International.EInvoicing.Countries.Iceland.csproj" />
  </ItemGroup>

  <!--
    The playground is a Blazor WebAssembly app and cannot be referenced from a test project, but the part
    worth testing is plain C#: the country descriptions that drive every menu on the site. They are compiled
    in here so a country that stops producing a valid invoice fails the build rather than the demo.
  -->
  <ItemGroup>
    <Compile Include="../../web/Playground/Services/PlaygroundCountry.cs" />
    <Compile Include="../../web/Playground/Services/PlaygroundCountries.cs" />
  </ItemGroup>

</Project>
